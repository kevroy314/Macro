# ---------------------------------------------------------------- secrets
# The release signing key. If this is ever committed, anyone can sign an update
# that the in-app updater will accept as genuine. It must stay off the repo.
*.jks
*.jks.*
*.keystore
keystore.properties

# Everything the daemon holds: API keys, who has one, food photos, backups,
# session transcripts, the certificate's private key.
#
# Written as data/* rather than data/ so the template below can be re-included —
# git cannot un-ignore a file inside an excluded directory.
macropad-ai/data/*
!macropad-ai/data/env.example

# ------------------------------------------------------------ build output
*.apk
*.aab
build/
.gradle/
local.properties
*.tmp
captures/
.externalNativeBuild/
.cxx/

# ------------------------------------------------------------------- tools
.idea/
*.iml
.DS_Store
__pycache__/
*.py[cod]
.venv/
venv/

# Per-machine compose overlay selection, not a project default.
macropad-ai/.env
