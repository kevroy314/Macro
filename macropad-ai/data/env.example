# macropad-ai runtime configuration.
# This file is git-ignored. Everything here is optional.

# Set to use a pay-per-token API key instead of the mounted Claude subscription
# credentials. Leave empty (or delete the line) to use the subscription.
# ANTHROPIC_API_KEY=

# Model used for macro estimation.
MACROPAD_MODEL=claude-opus-5

# Concurrent Claude sessions.
MACROPAD_MAX_CONCURRENT=2

# Hard ceiling on a single estimation session.
MACROPAD_MAX_TURNS=40

# Days to keep uploaded images. 0 disables the sweep.
MACROPAD_IMAGE_RETENTION_DAYS=90
